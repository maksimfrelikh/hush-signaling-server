# Per-host values for the TURN relay. The installer keeps them in
# /etc/hushsend-turn/turn.env (root, 0600) — `sudo deploy/turn/install.sh --import`
# creates that file from the host's current /etc/turnserver.conf.
#
# Plain KEY=value lines, no inline comments. NO SECRET HERE: the shared secret is
# read from the signaling server's own .env (TURN_SECRET) at install time.

# The TURN hostname clients are given (TURN_URLS in the signaling .env).
REALM=turn.example.org
LISTEN_PORT=3478
TLS_LISTEN_PORT=5349
# Behind NAT: PUBLIC/PRIVATE, e.g. 203.0.113.7/192.168.1.19. Empty on a host
# that has its public address on an interface.
EXTERNAL_IP=
MIN_PORT=49160
MAX_PORT=49200
USER_QUOTA=12
TOTAL_QUOTA=1200
MAX_BPS=5000000
